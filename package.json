{
  "name": "yunqiagent-desktop",
  "version": "0.2.17",
  "type": "module",
  "description": "云栖 Agent · 可定制 Windows 工作台",
  "author": "YunqiAgent contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "tsx tests/desktop.ts",
    "pack": "npm run build && electron-builder --win dir",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "io.github.yunqiagent.desktop",
    "productName": "YunqiAgent",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "examples",
        "to": "examples"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "YunqiAgent-${version}-Windows-x64.exe",
      "useZip": true
    }
  }
}
